          "target": "components/live/corners/index.ts"
        },
        {
          "path": "registry/live/corners/corner.tsx",
          "type": "registry:component",
          "target": "components/live/corners/corner.tsx"
        },
        {
          "path": "registry/live/corners/download-button.tsx",
          "type": "registry:component",
          "target": "components/live/corners/download-button.tsx"
        }
      ]
    }
  ]
